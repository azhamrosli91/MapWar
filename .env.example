VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# DEMO_MAP_ID is suitable for local development. Use your own JavaScript map ID for production.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Server-only key for publishing/removing public previews. Leave empty to disable publishing.
# Set a long private value; never prefix this setting with VITE_. Restart after changing it.
PREVIEW_ADMIN_KEY=
# Optional for local use. Docker Compose uses its persistent preview-data volume.
PREVIEW_STORAGE_DIR=./data/previews
